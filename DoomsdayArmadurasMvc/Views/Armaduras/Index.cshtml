@model IEnumerable<DoomsdayArmadurasMvc.Models.Armadura>

@{
    ViewBag.Title = "Index";
}

<h2>Bienvenido al Registro de Armaduras</h2>
<p>Seleccione una opción en la navegación para comenzar.</p>

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Reino.Nombre)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Nombre)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Nivel)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Portador)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Reino.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nivel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Portador)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.ArmaduraId }) |
                @Html.ActionLink("Details", "Details", new { id = item.ArmaduraId }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.ArmaduraId })
            </td>
        </tr>
    }

</table>
